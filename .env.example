# Example variable names only. Never commit real credentials.
# Prefer Hardhat vars locally and encrypted secret storage in CI.

# Contract deployment and verification
HARDHAT_VAR_SEPOLIA_RPC_URL=
HARDHAT_VAR_SEPOLIA_PRIVATE_KEY=
HARDHAT_VAR_ETHERSCAN_API_KEY=

# Permissionless keeper
SEPOLIA_RPC_URL=
KEEPER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
KEEPER_MAX_BALANCE_WEI=100000000000000000
POLL_INTERVAL_MS=15000

# Optional local tooling
REPORT_GAS=false

# Leopold frontend authentication (names only; configure values in the
# frontend deployment environment, never in git).
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
NEXT_PUBLIC_DYNAMIC_API_BASE_URL=
NEXT_PUBLIC_LEOPOLD_ENABLE_X_AUTH=0
DYNAMIC_API_SECRET=

# Explicit non-production fixture controls only.
NEXT_PUBLIC_LEOPOLD_AUTH_FIXTURE=
NEXT_PUBLIC_LEOPOLD_DEV_FIXTURE=0
