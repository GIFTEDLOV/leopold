{
  "name": "zama-szn4",
  "description": "Confidential prize-savings application for the Zama Developer Program Mainnet Season 4.",
  "version": "0.0.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.0.9"
  },
  "license": "BSD-3-Clause-Clear",
  "keywords": [
    "fhevm",
    "zama",
    "eth",
    "ethereum",
    "dapps",
    "wallet",
    "web3",
    "typescript",
    "hardhat"
  ],
  "dependencies": {
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.1",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/host-contracts": "0.10.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.30",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "4.5.0",
    "chai-as-promised": "8.0.2",
    "cross-env": "7.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "ethers": "6.17.0",
    "globals": "17.6.0",
    "hardhat": "2.28.6",
    "hardhat-deploy": "0.11.45",
    "hardhat-gas-reporter": "2.3.0",
    "mocha": "11.7.5",
    "prettier": "3.8.3",
    "prettier-plugin-solidity": "2.3.1",
    "rimraf": "6.1.3",
    "solhint": "6.2.1",
    "solidity-coverage": "0.8.17",
    "ts-generator": "0.1.1",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1"
  },
  "files": [
    "contracts"
  ],
  "scripts": {
    "audit:full": "pnpm audit",
    "cp0:audit:capture": "node scripts/cp0-capture-audit.cjs",
    "cp0:validate": "node scripts/validate-cp0-final-closure.cjs",
    "cp1:selector:hcu:validate": "ts-node --transpile-only scripts/validate-leopold-selector-hcu-evidence.ts",
    "cp1:compound:validate": "ts-node --transpile-only scripts/validate-leopold-compound-evidence.ts",
    "cp1:bond:smoke": "hardhat run scripts/leopold-bond-sepolia-smoke.ts --network sepolia",
    "phase2b:bytecode": "hardhat compile && node scripts/validate-leopold-auto-entry-bytecode.cjs",
    "phase2b:compiler:validate": "node scripts/validate-leopold-v2-compiler-consistency.cjs",
    "closure:bytecode": "node scripts/validate-leopold-bytecode.cjs",
    "closure:freeze:generate": "hardhat compile --force && node scripts/generate-leopold-contract-freeze.cjs",
    "closure:freeze:validate": "hardhat compile --force && node scripts/validate-leopold-contract-freeze.cjs",
    "closure:validate": "hardhat compile --force && pnpm closure:bytecode && node scripts/validate-leopold-contract-freeze.cjs",
    "audit:prod": "pnpm audit --prod",
    "build:ts": "tsc --project tsconfig.json",
    "chain": "hardhat node --network hardhat --no-deploy",
    "check:all": "pnpm check:contracts && pnpm check:frontend && pnpm check:keeper",
    "check:contracts": "pnpm compile && pnpm test && pnpm lint && pnpm build:ts",
    "check:frontend": "pnpm --filter @zama-szn4/frontend typecheck && pnpm --filter @zama-szn4/frontend lint && pnpm --filter @zama-szn4/frontend test && pnpm --filter @zama-szn4/frontend build",
    "check:keeper": "pnpm --filter @zama-szn4/keeper typecheck && pnpm --filter @zama-szn4/keeper lint && pnpm --filter @zama-szn4/keeper test && pnpm --filter @zama-szn4/keeper build && pnpm --filter @zama-szn4/keeper probe:fixture",
    "clean": "rimraf ./fhevmTemp ./artifacts ./cache ./coverage ./types ./coverage.json ./dist && pnpm typechain",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "coverage": "cross-env SOLIDITY_COVERAGE=true hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"test/**/*.ts\" && pnpm typechain",
    "deploy:anvil": "hardhat deploy --network anvil",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "deploy:v2:official": "hardhat run scripts/deploy-leopold-v2-official.ts --network sepolia",
    "deploy:v2:official:dry-run": "LEOPOLD_V2_OFFICIAL_DRY_RUN=1 hardhat run scripts/deploy-leopold-v2-official.ts --network sepolia",
    "deploy:v2:official:adopt": "node scripts/verify-leopold-v2-official-adoption.cjs",
    "lint": "pnpm lint:sol && pnpm lint:ts && pnpm prettier:check",
    "lint:sol": "solhint --disc --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "postcompile": "pnpm typechain",
    "prettier:check": "prettier --check \"**/*.{cjs,js,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{cjs,js,json,md,sol,ts,yml}\"",
    "release:validate": "node scripts/validate-leopold-production-release.cjs",
    "release:v2:validate": "node scripts/validate-leopold-v2-release-manifest.cjs",
    "test:governance": "node --test scripts/leopold-release-governance.test.cjs",
    "test:deployment:v2": "node --test scripts/leopold-v2-official-deployment.test.cjs",
    "sg2:deploy": "node scripts/sg2-launcher.cjs deploy",
    "sg2:preflight": "node scripts/sg2-launcher.cjs preflight",
    "sg2:prepare": "node scripts/sg2-launcher.cjs prepare --",
    "sg2:verify": "node scripts/sg2-launcher.cjs verify --",
    "sg3:derive": "ts-node --transpile-only scripts/sg3-domain.ts",
    "sg4:hcu-authority:candidate": "node scripts/sg4-hcu-authority-launcher.cjs candidate",
    "sg4:hcu-authority:post-commit": "node scripts/sg4-hcu-authority-launcher.cjs post-commit",
    "sg4:hcu-authority:generate": "ts-node --transpile-only scripts/sg4-hcu-authority-binding-generator.ts",
    "sg4:hcu-authority:generate:v2": "ts-node --transpile-only scripts/sg4-hcu-authority-binding-generator.ts --target LEOPOLD_V2_SEPOLIA --source-record scripts/sg4-hcu-authority-binding.json",
    "sg4:hcu-authority:preflight": "node scripts/sg4-hcu-authority-launcher.cjs preflight",
    "sg4:hcu-authority:protocol": "ts-node --transpile-only scripts/sg4-hcu-authority-protocol.ts",
    "sg4:protocol": "ts-node --transpile-only scripts/sg4-protocol.ts",
    "sg4:randomness:live": "hardhat run scripts/sg4-randomness-benchmark.ts --network sepolia",
    "sg4:randomness:receipts": "hardhat run scripts/verify-sg4-randomness-receipts.ts --network sepolia",
    "sg4:randomness:validate": "ts-node --transpile-only scripts/validate-sg4-randomness-evidence.ts",
    "sg5:preflight": "node scripts/sg5-preflight.cjs",
    "sg5:live": "node scripts/sg5-live.cjs live",
    "sg5:protocol": "ts-node --transpile-only scripts/sg5-protocol.ts",
    "sg5:structural": "pnpm --filter @zama-szn4/frontend test:sg5",
    "sg5:evidence:validate": "node scripts/validate-sg5-evidence.cjs",
    "test": "hardhat test test/*.ts",
    "test:sepolia": "hardhat test --network sepolia",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "verify:sepolia": "hardhat verify --network sepolia"
  },
  "overrides": {
    "ws@>=7.0.0 <7.5.10": ">=7.5.10",
    "axios@>=1.3.2 <=1.7.3": ">=1.7.4",
    "elliptic@>=4.0.0 <=6.5.6": ">=6.5.7",
    "elliptic@>=2.0.0 <=6.5.6": ">=6.5.7",
    "elliptic@>=5.2.1 <=6.5.6": ">=6.5.7",
    "micromatch@<4.0.8": ">=4.0.8",
    "elliptic@<6.6.0": ">=6.6.0",
    "elliptic@<6.5.6": ">=6.5.6",
    "undici@>=6.0.0 <6.21.1": ">=6.21.1 <7.0.0",
    "undici@>=4.5.0 <5.28.5": ">=5.28.5 <6.0.0",
    "elliptic@<=6.6.0": ">=6.6.1",
    "tar-fs@>=2.0.0 <2.1.2": ">=2.1.2",
    "axios@>=1.0.0 <1.8.2": ">=1.8.2",
    "axios@<0.29.1": ">=0.29.1",
    "cookie@<0.7.0": ">=0.7.0",
    "minimatch": "^3.1.2",
    "ws": "8.21.0"
  },
  "packageManager": "pnpm@11.0.9",
  "private": true
}
