# Example variable names only. Never commit real credentials.
# Prefer Hardhat vars locally and encrypted secret storage in CI.

# Contract deployment and verification
HARDHAT_VAR_SEPOLIA_RPC_URL=
HARDHAT_VAR_SEPOLIA_PRIVATE_KEY=
HARDHAT_VAR_ETHERSCAN_API_KEY=

# Permissionless keeper
SEPOLIA_RPC_URL=
# Optional comma-separated fallbacks; the first URL is the primary.
SEPOLIA_RPC_URLS=
KEEPER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
KEEPER_MIN_BALANCE_WEI=10000000000000000
KEEPER_MAX_BALANCE_WEI=100000000000000000
POLL_INTERVAL_MS=15000
KEEPER_RECEIPT_WAIT_MS=180000
KEEPER_CONFIRMATIONS=1
KEEPER_AUTO_ENTRY_SCAN_SIZE=50
KEEPER_HISTORICAL_SCAN_SIZE=50
KEEPER_JOURNAL_PATH=./keeper-data/lifecycle-journal.json
KEEPER_MANIFEST_PATH=../config/leopold-frontend-contracts.json

# Optional local tooling
REPORT_GAS=false
