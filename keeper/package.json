{
  "name": "@zama-szn4/keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "keeper:once": "tsx src/cli.ts --once",
    "keeper:service": "tsx src/cli.ts --service",
    "lint": "eslint .",
    "probe": "tsx src/probe.ts",
    "probe:fixture": "tsx src/probe-fixture.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/query-core": "5.101.4",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "@zama-fhe/sdk": "3.4.0",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "p-retry": "8.0.0",
    "pino": "10.3.1",
    "viem": "2.55.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.15",
    "eslint": "9.39.2",
    "globals": "17.6.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.10"
  }
}
