    "WRAPPER_UNWRAP_FINALIZATION",
    "PRIVATE_DRAW_SETTLEMENT",
    "STRATEGY_EPOCH",
    "REPLENISHMENT"
  ],
  "normalFlows": {
    "makePrivate": {
      "walletTransactions": 2,
      "sequence": ["USDC.approve(lcUSDC)", "lcUSDC.wrap(user,amount)"]
    },
    "saveFirstTime": {
      "walletTransactions": 1,
      "sequence": ["lcUSDC.confidentialTransferAndCall(vault,...)"]
    },
    "saveReturning": {
      "walletTransactions": 1,
      "sequence": ["lcUSDC.confidentialTransferAndCall(vault,...)"]
    },
    "enterPrizeRound": {
      "walletTransactions": 1,
      "sequence": ["bondEscrow.registerForRound(roundId,{value:BOND_AMOUNT})"],
      "public": true
    },
    "claimBondRefund": {
      "walletTransactions": 1,
      "sequence": ["bondEscrow.claimBondRefund(roundId)"]
    },
    "withdrawPrincipal": {
      "walletTransactions": 1,
      "sequence": ["vault.withdraw(encryptedAmount,inputProof)"]
    },
    "withdrawWinnings": {
      "walletTransactions": 1,
      "sequence": ["vault.withdrawWinnings(encryptedAmount,inputProof)"]
    },
    "makePublic": {
      "walletTransactions": 2,
      "sequence": [
        "lcUSDC.unwrap(user,user,encryptedAmount,inputProof)",
        "lcUSDC.finalizeUnwrap(requestId,amount,publicProof)"
      ]
    },
    "privateEligibilityFirstRead": {
      "walletTransactions": 1,
      "sequence": [
        "vault.materializeMyRoundWeight(roundId)",
        "read RoundWeightMaterialized handle",
        "wallet user-decrypt offchain"
      ]
    },
    "privateResult": {
      "walletTransactions": 0,
      "sequence": ["read winningsOf(user)", "wallet user-decrypt offchain"]
    },
    "strategy": {
      "walletTransactions": 0,
      "sequence": ["protocol infrastructure only"]
    }
  },
